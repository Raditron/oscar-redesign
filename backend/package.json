{
  "name": "oscar-backend",
  "version": "0.1.0",
  "private": true,
  "description": "The Oscar Club content API: menu, events, hours and contacts. Deployed separately from the static site.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "hash-password": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/scripts/hash-password.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
