# The Oscar backend's env config: every environment variable it reads. For a local run, copy this file to .env
# (git ignores it) and fill it in; `npm start` reads .env when there is one. On the host, set the same variables in
# its environment. The backend checks every value at startup and refuses to start, naming the variable, if one is
# missing or wrong.

# The TCP port the HTTP server listens on. Many hosts set PORT themselves.
PORT=3000

# The MongoDB connection string. It must name the database (the part after the host, before any "?").
# The real one, with its user and password, only ever goes in .env or the host's environment.
MONGODB_URI=mongodb://localhost:27017/oscar

# Signs admin session tokens: at least 32 random characters. Changing it signs every admin out.
# One way to make one: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# The placeholder below is refused on purpose, so this file can't run as it is.
JWT_SECRET=replace-me

# The bcrypt hash of the shared admin password, never the password itself. A hash contains "$" characters:
# if a tool you use expands $VARIABLES in .env files, put the value in single quotes.
# The placeholder below is refused on purpose, so this file can't run as it is.
ADMIN_PASSWORD_HASH=replace-me

# The site's origins (scheme://host[:port], no path or trailing slash), separated by commas. A browser on any
# other origin gets no CORS headers, so it can't read the API's answers. localhost and 127.0.0.1 are refused here:
# CORS_ALLOW_LOCALHOST below is the one way to allow them.
CORS_ORIGINS=https://oscarclubsofia.com

# Development only: true also allows http://localhost and http://127.0.0.1 on any port. Off unless set to true.
CORS_ALLOW_LOCALHOST=false
